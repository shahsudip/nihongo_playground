+            </fieldset>
+            {!ready && <p className="cn2-notice" role="status">This answer key is awaiting verification. You can study the original scan, but answering and scoring are disabled until it is verified.</p>}
+            {isAnswered && <section key={question.id} className={`cn2-feedback${selected === question.correctIndex ? ' cn2-feedback--correct' : ''}`} aria-live="polite"><h4>{selected === question.correctIndex ? 'Correct. Nicely done.' : `Correct answer: printed option ${question.correctIndex + 1}`}</h4><p>Your answer: {selected + 1}. The verified answer key uses printed option numbers.</p>{extractedText(question.explanation).trim() ? <Explanation text={question.explanation} /> : <p>A verified explanation is not available for this question. No explanation has been invented.</p>}{question.explanationImage && <details className="cn2-ocr"><summary>Printed answer reference</summary><figure className="cn2-scan-frame"><Scan key={question.explanationImage} path={question.explanationImage} alt={`Printed answer reference for question ${question.number}; may include other answers`} /></figure></details>}</section>}
+          </article>
+          <div className="cn2-reader-navigation"><button className="cn2-button cn2-button--quiet" disabled={currentIndex <= 0} onClick={() => goTo(currentIndex - 1)}>Previous</button><Link className="cn2-text-link" to={`${BOOK_ROUTE}/${set.id}`}>Save & return to set</Link><button className="cn2-button" disabled={currentIndex >= questions.length - 1} onClick={() => goTo(currentIndex + 1)}>Next <Icon name="arrow" /></button></div>
+          {progress.isCompleted && <section className="cn2-completion" aria-label="Section results"><Icon name="check" /><h3>{progress.isMastered ? 'Section mastered!' : 'Section complete'}</h3><p>{progress.score} / {progress.total} correct ({progress.accuracyPercent}% practice accuracy).</p><p>Review any answer using the question navigator, or reset this section for a fresh attempt.</p><Link className="cn2-button" to={`${BOOK_ROUTE}/${set.id}`}>Choose another section</Link></section>}
+        </div>
+        <aside className="cn2-quiz-sidebar"><div className="cn2-sidebar-card"><div className="cn2-row"><h3>Your practice</h3><Status progress={progress} /></div><SectionRow section={section} progress={progress} /><div className="cn2-raw-score"><strong>{progress.score}</strong><span>raw correct / {progress.answered} answered</span></div><p className="cn2-muted">{progress.answered ? `${progress.accuracyPercent}% practice accuracy` : 'Your first answer starts your progress.'}</p><h4>Question navigator</h4><div className="cn2-question-grid">{questions.map((item, index) => {
+          const answer = answers[item.id];
+          const state = Number.isInteger(answer) ? answer === item.correctIndex ? 'correct' : 'incorrect' : 'unanswered';
+          return <button key={item.id} className={`cn2-question-dot cn2-question-dot--${state}`} aria-current={index === currentIndex ? 'step' : undefined} aria-label={`Question ${item.number ?? index + 1}, ${state}${!isQuestionReady(item) ? ', key pending' : ''}`} onClick={() => goTo(index)}>{item.number ?? index + 1}</button>;
+        })}</div><p className="cn2-muted cn2-small">Green: correct. Red: review. Outline: unanswered.</p><p className="cn2-muted cn2-small">Progress saves on this device after every answer and navigation. Practice results are not official JLPT scores.</p></div></aside>
+      </div>
+    </>
+  );
+}
+
+function BookSession({ userId }) {
+  const { setId, sectionId } = useParams();
+  const location = useLocation();
+  const [params] = useSearchParams();
+  const storageKey = storageKeyFor(userId);
+  const [attempts, setAttempts] = useState(() => readAttempts(storageKey));
+  const attemptsRef = useRef(attempts);
+  const [book, setBook] = useState(null);
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+  const [cloudNotice, setCloudNotice] = useState('');
+  const cloudQueue = useRef(Promise.resolve());
+  const [retry, setRetry] = useState(0);
+  useEffect(() => {
+    let cancelled = false;
+    loadChokuzenN2Book().then(data => { if (!cancelled) setBook(data); }).catch(failure => { if (!cancelled) setError(failure.message); });
+    return () => { cancelled = true; };
+  }, [retry]);
+  useEffect(() => {
+    let cancelled = false;
+    loadCloudAttempts(userId).then(incoming => {
+      if (cancelled) return;
+      const merged = mergeAttempts(attemptsRef.current, incoming);
+      attemptsRef.current = merged;
+      setAttempts(merged);
+    }).catch(() => { if (!cancelled) setNotice('Cloud history could not be read. Your separate device progress is still available.'); });
+    const onStorage = event => {
+      if (event.key !== storageKey && event.key !== null) return;
+      const updated = mergeAttempts(attemptsRef.current, readAttempts(storageKey));
+      attemptsRef.current = updated;
+      setAttempts(updated);
+    };
+    window.addEventListener('storage', onStorage);
+    return () => { cancelled = true; window.removeEventListener('storage', onStorage); };
+  }, [storageKey, userId]);
+  const save = record => {
+    const updated = { ...mergeAttempts(attemptsRef.current, readAttempts(storageKey)), [record.quizId]: record };
+    attemptsRef.current = updated;
+    setAttempts(updated);
+    try {
+      window.localStorage.setItem(storageKey, JSON.stringify(updated));
+    } catch {
+      setNotice('Device storage is unavailable or full. Progress works in this tab but may not survive a reload.');
+    }
+    if (!import.meta.env.DEV && userId) {
+      cloudQueue.current = cloudQueue.current.catch(() => {}).then(() => saveCloudAttempt(userId, record)).then(() => {
+        setCloudNotice('');
+      }).catch(() => {
+        setCloudNotice('Cloud sync failed. Your progress is saved on this device. Answer or navigate again to retry.');
+      });
+    }
+  };
+  if (!book) return <main className="cn2-book"><section className="cn2-empty" aria-live="polite"><span className="cn2-level">N2</span><h1>{error ? 'The book is not ready yet' : 'Opening your practice book...'}</h1><p>{error || 'Loading original pages and practice sets.'}</p>{error && <button className="cn2-button" onClick={() => { setError(''); setRetry(value => value + 1); }}>Try again</button>}<Link className="cn2-text-link" to="/books">Back to books</Link></section></main>;
+  const set = book.sets.find(item => item.id === setId);
+  const section = sectionFromRoute(sectionId);
+  const groups = book.sets.flatMap(item => SECTIONS.map(definition => sectionProgress(item.sections?.[definition.id]?.questions || [], attempts[attemptId(item.id, definition.id)])));
+  const overall = summarizeProgress(groups);
+  const readerOpen = params.get('reader') === '1';
+  const readerLink = `${location.pathname}?reader=1&page=${set?.sourcePages?.[0] || 1}`;
+  const invalidRoute = (setId && !set) || (sectionId && !section);
+  return (
+    <main className="cn2-book">
+      <nav className="cn2-breadcrumb" aria-label="Breadcrumb"><Link to="/books">Books</Link><span aria-hidden="true">/</span><Link to={BOOK_ROUTE} aria-current={!setId ? 'page' : undefined}>Chokuzen Taisaku N2</Link>{set && <><span aria-hidden="true">/</span><Link to={`${BOOK_ROUTE}/${set.id}`} aria-current={!sectionId ? 'page' : undefined}>{set.title}</Link></>}{section && <><span aria-hidden="true">/</span><span aria-current="page">{section.title}</span></>}</nav>
+      {!sectionId && !readerOpen && <header className="cn2-hero"><div className="cn2-hero-copy"><p className="cn2-eyebrow">THE FINAL STRETCH / JLPT N2</p><h1>Small steps.<br />Exam-day confidence.</h1><p className="cn2-book-title" lang="ja">{book.title}</p><p className="cn2-muted">Original pages. Focused practice. A clearer path forward.</p><div className="cn2-hero-actions"><Link className="cn2-button" to={readerLink}><Icon name="book" />Read original book</Link><span className="cn2-pill">{book.sets.length} sets / {overall.total} questions</span></div></div><div className="cn2-cover"><Scan path={book.coverImage || book.cover || '/books/chokuzen_n2/cover.jpeg'} alt="Chokuzen Taisaku N2 book cover" eager /><span>CHOKUZEN TAISAKU <strong>N2</strong></span></div></header>}
+      <div className="cn2-session-line"><Icon name="check" /><p>{notice ? 'Progress kept in this tab' : 'Progress saved on this device'}</p>{sectionId && !readerOpen && <Link className="cn2-text-link" to={readerLink}>Source reader</Link>}</div>
+      {notice && <p className="cn2-notice" role="status">{notice}</p>}
+      {cloudNotice && <p className="cn2-notice" role="alert">{cloudNotice}</p>}
+      {readerOpen ? <Reader book={book} /> : invalidRoute ? <section className="cn2-empty"><h2>That set or section was not found.</h2><Link className="cn2-button" to={BOOK_ROUTE}>View all N2 sets</Link></section> : section && set ? <Quiz key={`${set.id}:${section.id}`} set={set} section={section} record={attempts[attemptId(set.id, section.id)]} onSave={save} /> : <><Overview progress={set ? setProgress(set, attempts) : overall} groups={set ? SECTIONS.map(definition => sectionProgress(set.sections?.[definition.id]?.questions || [], attempts[attemptId(set.id, definition.id)])) : groups} />{set ? <SetDetails set={set} attempts={attempts} /> : <SetList book={book} attempts={attempts} />}</>}
+    </main>
+  );
+}
+
+export default function ChokuzenN2Book() {
+  const { currentUser } = useAuth() || {};
+  return <BookSession key={currentUser?.uid || 'guest'} userId={currentUser?.uid || null} />;
+}
diff --git a/src/utils/chokuzenN2Data.js b/src/utils/chokuzenN2Data.js
new file mode 100644
--- /dev/null
+++ b/src/utils/chokuzenN2Data.js
@@ -0,0 +1,174 @@
+import { getQuestionGroupProgress, summarizeProgress } from './bookProgress.js';
+
+export const BOOK_ID = 'jlpt-n2-practice-sets';
+export const BOOK_ROUTE = '/n2-practice-sets';
+export const SECTIONS = [
+  { id: 'vocabulary-kanji', route: 'vocabulary-kanji', title: 'Vocabulary & Kanji', label: 'WORDS & CHARACTERS', tone: 'blue' },
+  { id: 'grammar-reading', route: 'grammar', title: 'Grammar', label: 'PATTERNS & CONTEXT', tone: 'green' },
+];
+
+export const sectionFromRoute = route => SECTIONS.find(section => section.route === route || section.id === route);
+
+export const attemptId = (setId, sectionId) => `${BOOK_ID}-${setId}-${sectionId}`;
+
+export const storageKeyFor = userId => `chokuzen-n2:${import.meta.env?.DEV ? 'dev' : 'production'}:v1:${userId || 'guest'}`;
+
+export const isQuestionReady = question => (
+  Boolean(question?.id)
+  && Array.isArray(question.options)
+  && question.options.length === 4
+  && Number.isInteger(question.correctIndex)
+  && question.correctIndex >= 0
+  && question.correctIndex < 4
+  && question.correctOption === question.options[question.correctIndex]
+  && question.verification?.answerKeyVerified === true
+);
+
+export function validAnswers(questions = [], answers = {}) {
+  return Object.fromEntries(questions
+    .filter(question => isQuestionReady(question)
+      && Number.isInteger(answers?.[question.id])
+      && answers[question.id] >= 0
+      && answers[question.id] < 4)
+    .map(question => [question.id, answers[question.id]]));
+}
+
+export function sectionProgress(questions = [], record) {
+  const answers = validAnswers(questions, record?.answers);
+  return getQuestionGroupProgress(questions, { scopedRecords: [{ answers }] });
+}
+
+export function setProgress(set, attempts) {
+  return summarizeProgress(SECTIONS.map(section => sectionProgress(
+    set.sections?.[section.id]?.questions || [],
+    attempts[attemptId(set.id, section.id)],
+  )));
+}
+
+export function makeAttempt(set, section, previous, changes = {}) {
+  const questions = set.sections?.[section.id]?.questions || [];
+  const answers = validAnswers(questions, changes.answers ?? previous?.answers);
+  const progress = sectionProgress(questions, { answers });
+  const index = Number(changes.currentIndex ?? previous?.currentIndex) || 0;
+  return {
+    quizId: attemptId(set.id, section.id),
+    bookId: BOOK_ID,
+    setId: set.id,
+    sectionId: section.id,
+    title: `Chokuzen Taisaku N2 - ${set.title} - ${section.title}`,
+    level: 'N2',
+    category: 'Chokuzen Taisaku',
+    type: 'practice',
+    answers,
+    currentIndex: Math.max(0, Math.min(questions.length - 1, Math.floor(index))),
+    currentQuestionId: questions[Math.max(0, Math.min(questions.length - 1, Math.floor(index)))]?.id || null,
+    score: progress.score,
+    rawCorrect: progress.score,
+    total: progress.total,
+    answered: progress.answered,
+    completionPercent: progress.completionPercent,
+    percentage: progress.accuracyPercent,
+    status: progress.status,
+    scoringMethod: 'raw-practice-accuracy',
+    timestamp: new Date().toISOString(),
+  };
+}
+
+export function mergeAttempts(current = {}, incoming = {}) {
+  const merged = { ...current };
+  Object.entries(incoming).forEach(([key, record]) => {
+    if (!record || typeof record !== 'object' || !key.startsWith(`${BOOK_ID}-`)) return;
+    const existingTime = Date.parse(merged[key]?.timestamp || '') || 0;
+    const incomingTime = Date.parse(record.timestamp || '') || 0;
+    if (!merged[key] || incomingTime > existingTime) merged[key] = record;
+  });
+  return merged;
+}
+
+export function readAttempts(storageKey) {
+  try {
+    const saved = JSON.parse(window.localStorage.getItem(storageKey) || '{}');
+    return saved && typeof saved === 'object' && !Array.isArray(saved) ? mergeAttempts({}, saved) : {};
+  } catch {
+    return {};
+  }
+}
+
+export function assetUrl(path) {
+  if (!path || typeof path !== 'string') return '';
+  if (/^https?:\/\//i.test(path)) return path;
+  if (path.startsWith('//') || /^[a-z][a-z\d+.-]*:/i.test(path)) return '';
+  const base = import.meta.env?.BASE_URL || '/';
+  if (base !== '/' && path.startsWith(base)) return path;
+  return `${base.replace(/\/$/, '')}/${path.replace(/^\/+/, '')}`;
+}
+
+export function extractedText(value) {
+  if (typeof value === 'string') return value;
+  return typeof value?.text === 'string' ? value.text : '';
+}
+
+export function sourcePages(book) {
+  const pages = Array.isArray(book.source?.pages) ? book.source.pages : [];
+  const count = Math.max(Number(book.source?.pageCount) || 0, ...pages.map(page => Number(page.page) || 0));
+  const pageMap = new Map(pages.map(page => [Number(page.page), page]));
+  return Array.from({ length: count }, (_, index) => ({ ...pageMap.get(index + 1), page: index + 1 }));
+}
+
+export async function loadChokuzenN2Book() {
+  let book;
+  if (import.meta.env.DEV) {
+    const localBooks = import.meta.glob('../data/chokuzen_n2/book.json');
+    const loader = localBooks['../data/chokuzen_n2/book.json'];
+    if (!loader) throw new Error('The local N2 book is still being prepared. Please retry when book.json is ready.');
+    book = (await loader()).default;
+  } else {
+    const [{ db }, { collection, doc, getDoc, getDocs }] = await Promise.all([
+      import('../firebaseConfig.js'),
+      import('firebase/firestore'),
+    ]);
+    const [metadata, sets] = await Promise.all([
+      getDoc(doc(db, 'books', BOOK_ID)),
+      getDocs(collection(db, 'books', BOOK_ID, 'sets')),
+    ]);
+    if (!metadata.exists()) throw new Error('This book has not been published to the library yet.');
+    book = { ...metadata.data(), sets: sets.docs.map(set => ({ ...set.data(), id: set.id })) };
+  }
+  if (!book || !Array.isArray(book.sets)) throw new Error('Book data is incomplete. Please try again later.');
+  return {
+    ...book,
+    id: BOOK_ID,
+    sets: [...book.sets].sort((left, right) => String(left.id).localeCompare(String(right.id), undefined, { numeric: true })),
+  };
+}
+
+export async function loadCloudAttempts(userId) {
+  if (import.meta.env.DEV || !userId) return {};
+  const [{ db }, { collection, getDocs }] = await Promise.all([
+    import('../firebaseConfig.js'),
+    import('firebase/firestore'),
+  ]);
+  const history = await getDocs(collection(db, 'users', userId, 'quizHistory'));
+  const attempts = {};
+  history.docs.forEach(snapshot => {
+    const record = snapshot.data();
+    const key = record.quizId || snapshot.id;
+    if (record.bookId === BOOK_ID && key.startsWith(`${BOOK_ID}-`)) {
+      const section = sectionFromRoute(record.sectionId);
+      attempts[section && record.setId ? attemptId(record.setId, section.id) : key] = record;
+    }
+  });
+  return attempts;
+}
+
+export async function saveCloudAttempt(userId, record) {
+  if (import.meta.env.DEV || !userId) return false;
+  const [{ db }, { doc, setDoc }] = await Promise.all([
+    import('../firebaseConfig.js'),
+    import('firebase/firestore'),
+  ]);
+  await setDoc(doc(db, 'users', userId, 'quizHistory', record.quizId), record, {
+    mergeFields: Object.keys(record),
+  });
+  return true;
+}
