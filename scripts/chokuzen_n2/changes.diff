+import { createElement, useEffect, useMemo, useRef, useState } from 'react';
+import { Link, useLocation, useParams, useSearchParams } from 'react-router-dom';
+import { useAuth } from '../context/AuthContext.jsx';
+import { summarizeProgress } from '../utils/bookProgress.js';
+import {
+  BOOK_ROUTE, SECTIONS, assetUrl, attemptId, extractedText, isQuestionReady,
+  loadChokuzenN2Book, loadCloudAttempts, makeAttempt, mergeAttempts, readAttempts, saveCloudAttempt,
+  sectionFromRoute, sectionProgress, setProgress, sourcePages, storageKeyFor, validAnswers,
+} from '../utils/chokuzenN2Data.js';
+import '../assets/chokuzen_n2.css';
+
+const STATUS_LABELS = {
+  'not-started': 'Ready to begin',
+  'in-progress': 'In progress',
+  completed: 'Completed',
+  mastered: 'Mastered',
+};
+
+function Icon({ name, ...props }) {
+  const paths = {
+    book: 'M4 4h6a3 3 0 0 1 3 3v14a4 4 0 0 0-4-3H4z M20 4h-4a3 3 0 0 0-3 3v14a4 4 0 0 1 4-3h3z',
+    arrow: 'M5 12h14 M13 6l6 6-6 6',
+    check: 'M5 12l4 4L19 6',
+    grid: 'M4 4h6v6H4z M14 4h6v6h-6z M4 14h6v6H4z M14 14h6v6h-6z',
+  };
+  return <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.7" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true" {...props}><path d={paths[name] || paths.book} /></svg>;
+}
+
+function ProgressBar({ progress, label }) {
+  return (
+    <div className="cn2-meter" role="progressbar" aria-label={label} aria-valuemin={0} aria-valuemax={100} aria-valuenow={progress.completionPercent}>
+      <span style={{ width: `${progress.completionPercent}%` }} />
+    </div>
+  );
+}
+
+function Status({ progress }) {
+  return <span className={`cn2-status cn2-status--${progress.status}`}>{STATUS_LABELS[progress.status]}</span>;
+}
+
+function TextBlock({ text }) {
+  return <div className="cn2-extracted" lang="ja">{extractedText(text).split(/\n\s*\n/).filter(Boolean).map((paragraph, index) => <p key={index}>{paragraph}</p>)}</div>;
+}
+
+function Explanation({ text, inline = false }) {
+  const formatted = useMemo(() => {
+    const allowed = new Set(['b', 'strong', 'u', 'br', 'ruby', 'rt', 'rp', 'em', 'p']);
+    const blocked = new Set(['script', 'style', 'iframe', 'object', 'embed', 'svg', 'math', 'template']);
+    const document = new DOMParser().parseFromString(extractedText(text), 'text/html');
+    const renderNode = (node, index) => {
+      if (node.nodeType === 3) return node.textContent;
+      if (node.nodeType !== 1) return null;
+      const tag = node.tagName.toLowerCase();
+      if (blocked.has(tag)) return null;
+      const children = Array.from(node.childNodes, renderNode);
+      if (!allowed.has(tag)) return children;
+      return tag === 'br' ? createElement(tag, { key: index }) : createElement(tag, { key: index }, ...children);
+    };
+    return Array.from(document.body.childNodes, renderNode);
+  }, [text]);
+  return createElement(inline ? 'span' : 'div', { className: 'cn2-explanation', lang: 'ja' }, formatted);
+}
+
+function QuestionScan({ path, label, verified }) {
+  const content = <figure className="cn2-scan-frame cn2-question-scan" tabIndex={0} aria-label={`${label}; scroll horizontally to read`}><figcaption>{label}<a className="cn2-text-link" href={assetUrl(path)} target="_blank" rel="noreferrer">Open full-resolution scan</a></figcaption><Scan key={path} path={path} alt={label} eager={!verified} /></figure>;
+  return verified ? <details className="cn2-ocr"><summary>Compare with the original print</summary>{content}</details> : content;
+}
+
+function OcrDetails({ text, label = 'Searchable extracted text' }) {
+  if (!extractedText(text).trim()) return null;
+  return (
+    <details className="cn2-ocr">
+      <summary>{label} <span>OCR / not authoritative</span></summary>
+      <p className="cn2-muted">OCR can misread characters and furigana. Always refer to the printed scan.</p>
+      <TextBlock text={text} />
+    </details>
+  );
+}
+
+function Scan({ path, alt, width, height, eager = false }) {
+  const [failed, setFailed] = useState(false);
+  const url = assetUrl(path);
+  if (!url || failed) return <p className="cn2-image-error" role="status">Scan unavailable. {url && <a href={url} target="_blank" rel="noreferrer">Try opening the original image</a>}</p>;
+  return <img className="cn2-scan" src={url} alt={alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} decoding="async" onError={() => setFailed(true)} />;
+}
+
+function Overview({ progress, groups }) {
+  return (
+    <section className="cn2-overview" aria-label="Practice progress">
+      <div className="cn2-overview-main">
+        <div className="cn2-row"><strong>Overall question progress</strong><strong className="cn2-accent">{progress.completionPercent}%</strong></div>
+        <ProgressBar progress={progress} label="Overall completion" />
+        <p className="cn2-muted">{progress.answered} / {progress.total} questions answered</p>
+      </div>
+      <div className="cn2-stat"><strong>{groups.filter(group => group.isCompleted).length} / {groups.length}</strong><span>Sections complete</span></div>
+      <div className="cn2-stat"><strong>{groups.filter(group => group.isMastered).length}</strong><span>Sections mastered</span></div>
+      <div className="cn2-stat"><strong>{progress.answered ? `${progress.accuracyPercent}%` : '--'}</strong><span>Practice accuracy</span></div>
+    </section>
+  );
+}
+
+function SectionRow({ section, progress }) {
+  return (
+    <div className={`cn2-section-row cn2-tone--${section.tone}`}>
+      <div className="cn2-row"><span>{section.title}</span><strong>{progress.completionPercent}%</strong></div>
+      <ProgressBar progress={progress} label={`${section.title} completion`} />
+      <small>{progress.answered} / {progress.total} answered{progress.answered > 0 && ` - ${progress.score} correct`}</small>
+    </div>
+  );
+}
+
+function SetList({ book, attempts }) {
+  return (
+    <>
+      <div className="cn2-section-heading"><div><p className="cn2-eyebrow">YOUR PRACTICE LIBRARY</p><h2>One set closer to confidence.</h2></div><span className="cn2-pill">{book.sets.length} practice sets</span></div>
+      <div className="cn2-set-grid">
+        {book.sets.map((set, index) => {
+          const progress = setProgress(set, attempts);
+          return (
+            <Link key={set.id} className={`cn2-set-card cn2-card--${progress.status}`} to={`${BOOK_ROUTE}/${set.id}`}>
+              <div className="cn2-row"><Status progress={progress} /><span className="cn2-set-number">{String(index + 1).padStart(2, '0')}</span></div>
+              <h3>{set.title}</h3>
+              <div className="cn2-section-rows">{SECTIONS.map(section => <SectionRow key={section.id} section={section} progress={sectionProgress(set.sections?.[section.id]?.questions || [], attempts[attemptId(set.id, section.id)])} />)}</div>
+              <div className="cn2-card-action"><span>{progress.isCompleted ? 'Review set' : progress.answered ? 'Continue practice' : 'Explore set'}</span><Icon name="arrow" /></div>
+            </Link>
+          );
+        })}
+      </div>
+      {book.sets.length === 0 && <div className="cn2-empty">Practice sets are being prepared. The original source reader is available above.</div>}
+    </>
+  );
+}
+
+function SetDetails({ set, attempts }) {
+  return (
+    <>
+      <div className="cn2-section-heading"><div><p className="cn2-eyebrow">CHOOSE YOUR FOCUS</p><h2>{set.title}</h2></div><Status progress={setProgress(set, attempts)} /></div>
+      <div className="cn2-section-grid">
+        {SECTIONS.map(section => {
+          const questions = set.sections?.[section.id]?.questions || [];
+          const progress = sectionProgress(questions, attempts[attemptId(set.id, section.id)]);
+          const readyCount = questions.filter(isQuestionReady).length;
+          return (
+            <Link key={section.id} to={`${BOOK_ROUTE}/${set.id}/${section.route}`} className={`cn2-section-card cn2-tone--${section.tone}`}>
+              <div className="cn2-row"><span className="cn2-section-icon"><Icon name={section.tone === 'blue' ? 'grid' : 'book'} /></span><Status progress={progress} /></div>
+              <p className="cn2-eyebrow">{section.label}</p><h3>{section.title}</h3>
+              <p className="cn2-muted">Original scans, four choices, focused review.</p>
+              <SectionRow section={section} progress={progress} />
+              {readyCount < questions.length && <p className="cn2-muted">{readyCount} / {questions.length} answer keys ready. Unverified questions are view-only.</p>}
+              <div className="cn2-card-action"><span>{progress.isCompleted ? 'Review answers' : progress.answered ? 'Resume section' : 'Open section'}</span><Icon name="arrow" /></div>
+            </Link>
+          );
+        })}
+      </div>
+      <aside className="cn2-study-note"><Icon name="book" /><div><strong>A little practice, a clearer understanding.</strong><p>Read the original scan first. Answers reveal explanations only after you choose. Mastery means every question answered with more than 90% correct.</p><p>Scores are raw practice accuracy, not an official JLPT score or pass prediction.</p></div></aside>
+    </>
+  );
+}
+
+function Reader({ book }) {
+  const [params, setParams] = useSearchParams();
+  const [query, setQuery] = useState('');
+  const [zoom, setZoom] = useState(100);
+  const pages = sourcePages(book);
+  const pageNumber = Math.max(1, Math.min(pages.length || 1, Number(params.get('page')) || 1));
+  const currentPage = pages[pageNumber - 1];
+  const pageText = extractedText(currentPage?.text || currentPage?.ocrText || currentPage?.ocr);
+  const normalizedQuery = query.trim().toLocaleLowerCase();
+  const matches = normalizedQuery ? pages.filter(page => extractedText(page.text || page.ocrText || page.ocr).toLocaleLowerCase().includes(normalizedQuery)) : [];
+  const hasOcr = pages.some(page => extractedText(page.text || page.ocrText || page.ocr).trim());
+  const goTo = target => {
+    const next = new URLSearchParams(params);
+    next.set('page', String(Math.max(1, Math.min(pages.length || 1, target))));
+    setParams(next);
+  };
+  const close = new URLSearchParams(params);
+  close.delete('reader');
+  close.delete('page');
+  return (
+    <section className="cn2-reader" aria-label="Original book source reader">
+      <div className="cn2-section-heading"><div><p className="cn2-eyebrow">THE ORIGINAL, IN FULL</p><h2>Source reader</h2><p className="cn2-muted">{pages.length} source pages. Page numbers below refer to the PDF, not printed numbering.</p></div><Link className="cn2-button cn2-button--quiet" to={{ search: close.toString() }}>Return to practice</Link></div>
+      <div className="cn2-reader-tools">
+        <form className="cn2-inline-form" key={pageNumber} onSubmit={event => { event.preventDefault(); const target = Number(new FormData(event.currentTarget).get('page')); if (Number.isInteger(target)) goTo(target); }}>
+          <label htmlFor="cn2-page">Source page</label><input id="cn2-page" name="page" type="number" min="1" max={pages.length || 1} defaultValue={pageNumber} required /><span>/ {pages.length}</span><button className="cn2-button cn2-button--quiet" type="submit">Go</button>
+        </form>
+        <div className="cn2-toolbar"><button className="cn2-button cn2-button--quiet" onClick={() => setZoom(value => Math.max(100, value - 25))} disabled={zoom <= 100} aria-label="Zoom out">-</button><output aria-live="polite">{zoom}%</output><button className="cn2-button cn2-button--quiet" onClick={() => setZoom(value => Math.min(250, value + 25))} disabled={zoom >= 250} aria-label="Zoom in">+</button></div>
+        {currentPage?.image && <a className="cn2-text-link" href={assetUrl(currentPage.image)} target="_blank" rel="noreferrer">Open full-resolution scan</a>}
+      </div>
+      <label className="cn2-search-label" htmlFor="cn2-source-search">Search source OCR <span className="cn2-muted">(imperfect extracted text)</span></label>
+      <input className="cn2-search" id="cn2-source-search" type="search" value={query} onChange={event => setQuery(event.target.value)} placeholder={hasOcr ? 'Find a word or phrase in the book...' : 'Search becomes available when OCR is published'} disabled={!hasOcr} />
+      {normalizedQuery && <div className="cn2-search-results"><p role="status">{matches.length} matching pages</p><div>{matches.map(page => <button key={page.page} className="cn2-button cn2-button--quiet" aria-current={page.page === pageNumber ? 'page' : undefined} onClick={() => goTo(page.page)}>Page {page.page}</button>)}</div></div>}
+      <div className="cn2-reader-canvas" tabIndex={0} aria-label={`Source page ${pageNumber}; scroll horizontally when zoomed`}><div style={{ width: `${zoom}%` }}>{currentPage?.image ? <Scan key={currentPage.image} path={currentPage.image} alt={`Original book scan, source PDF page ${pageNumber}`} width={currentPage.width} height={currentPage.height} eager /> : <div className="cn2-empty">This source page is not available yet.</div>}</div></div>
+      <div className="cn2-reader-navigation"><button className="cn2-button cn2-button--quiet" disabled={pageNumber <= 1} onClick={() => goTo(pageNumber - 1)}>Previous page</button><span aria-live="polite">Source page {pageNumber} / {pages.length}</span><button className="cn2-button" disabled={pageNumber >= pages.length} onClick={() => goTo(pageNumber + 1)}>Next page <Icon name="arrow" /></button></div>
+      <OcrDetails key={pageNumber} text={pageText} label={`Extracted text for source page ${pageNumber}`} />
+    </section>
+  );
+}
+
+function Quiz({ set, section, record, onSave }) {
+  const questions = set.sections?.[section.id]?.questions || [];
+  const answers = validAnswers(questions, record?.answers);
+  const savedIdIndex = questions.findIndex(question => question.id === record?.currentQuestionId);
+  const currentIndex = savedIdIndex >= 0 ? savedIdIndex : Math.max(0, Math.min(questions.length - 1, Number(record?.currentIndex) || 0));
+  const question = questions[currentIndex];
+  const progress = sectionProgress(questions, record);
+  const selected = question ? answers[question.id] : undefined;
+  const isAnswered = Number.isInteger(selected);
+  const ready = isQuestionReady(question);
+  const textVerified = question?.verification?.ocrTextVerified === true;
+  const passageVerified = question?.verification?.passageTextVerified === true;
+  const heading = useRef(null);
