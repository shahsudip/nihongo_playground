+  return (
+    <>
+      <div className="cn2-section-heading"><div><p className="cn2-eyebrow">{set.title}</p><h2>{section.title}</h2></div><button className="cn2-button cn2-button--quiet" onClick={reset}>Reset section</button></div>
+      <div className="cn2-quiz-layout">
+        <div className="cn2-question-column">
+          <article className="cn2-question-card" aria-labelledby="cn2-question-heading">
+            <div className="cn2-row"><h3 id="cn2-question-heading" ref={heading} tabIndex={-1}>Question {question.number ?? currentIndex + 1}</h3><span className="cn2-muted">{currentIndex + 1} / {questions.length}</span></div>
+            <div className="cn2-source-line"><span className="cn2-pill">{textVerified ? 'Japanese text' : 'Original printed scan'}</span><Link className="cn2-text-link" to={`?reader=1&page=${question.sourcePage || 1}`}>Source PDF p. {question.sourcePage || '--'}{question.printedPage ? ` / printed p. ${question.printedPage}` : ''}</Link></div>
+            {textVerified && <><div className="cn2-instruction"><Explanation text={question.instruction} /></div>{passageVerified && <div className="cn2-passage"><Explanation text={question.passage} /></div>}{question.questionText && <div className="cn2-stem"><Explanation text={question.questionText} /></div>}</>}
+            {!textVerified && <p className="cn2-muted">Underlining, furigana and the complete printed choices are preserved below.</p>}
+            {!textVerified && <p className="cn2-scan-hint">Swipe to read the full question, or open the full-resolution scan.</p>}
+            {question.passageImage && <QuestionScan path={question.passageImage} label="Original shared passage" verified={passageVerified} />}
+            <QuestionScan path={question.questionImage} label={`Original printed question ${question.number}`} verified={textVerified} />
+            {!textVerified && <OcrDetails key={question.id} text={[extractedText(question.instruction), extractedText(question.passage), extractedText(question.questionText)].filter(Boolean).join('\n\n')} />}
+            <fieldset className="cn2-choices" disabled={isAnswered || !ready}>
+              <legend>{textVerified ? 'Choose an answer' : 'Choose the printed option number'}</legend>
+              {!textVerified && <p className="cn2-muted">Compare with the full question scan. OCR readings and cropped choices can be imperfect.</p>}
+              {[0, 1, 2, 3].map(optionIndex => {
+                const isCorrect = isAnswered && optionIndex === question.correctIndex;
+                const isSelected = selected === optionIndex;
+                const optionImage = question.optionImages?.[optionIndex];
+                return (
+                  <div key={optionIndex} className="cn2-choice-item">
+                  <button type="button" className={`cn2-choice${isCorrect ? ' cn2-choice--correct' : ''}${isSelected && !isCorrect ? ' cn2-choice--incorrect' : ''}`} aria-label={`Choose printed option ${optionIndex + 1}`} aria-pressed={isSelected} onClick={() => { if (!isAnswered && ready) save({ answers: { ...answers, [question.id]: optionIndex }, currentIndex }); }}>
+                    <span className="cn2-choice-number">{optionIndex + 1}</span>
+                    <span className="cn2-choice-content">{textVerified ? <Explanation inline text={question.options[optionIndex]} /> : optionImage ? <Scan key={optionImage} path={optionImage} alt={`Printed option ${optionIndex + 1}; verify against the complete question scan`} eager /> : <><span>Printed option {optionIndex + 1}</span>{question.options?.[optionIndex] && <span className="cn2-choice-ocr" lang="ja">Extracted text (unverified): {question.options[optionIndex]}</span>}</>}</span>
