+        for offset, expected in enumerate(QUESTIONS_PER_PAGE):
+            printed_page = 8 + (set_number - 1) * 10 + offset
+            page_number = printed_to_pdf(printed_page)
+            source_pages.append(page_number)
+            if expected == 0:
